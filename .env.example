# Sao chép file này thành .env rồi thay các giá trị <...> bằng giá trị thật.
# File .env KHÔNG được commit (đã nằm trong .gitignore) và chỉ dùng cho máy local.

# ── MySQL trong Docker ───────────────────────────────────────────────
# Cổng mở ra trên máy host. Giữ 3306 nếu bạn muốn chạy `./mvnw verify`, vì
# MySqlTestConfiguration chỉ chấp nhận đúng jdbc:mysql://localhost:3306/lenglish_test.
# Máy đã có MySQL chiếm 3306 thì đổi sang 3307 (khi đó IT sẽ không chạy được).
MYSQL_HOST_PORT=3306

MYSQL_ROOT_PASSWORD=<mat-khau-root-ngau-nhien>
APP_DB_NAME=lenglish
APP_DB_USERNAME=lenglish_app
APP_DB_PASSWORD=<mat-khau-app-ngau-nhien>
TEST_DB_NAME=lenglish_test
TEST_DB_USERNAME=lenglish_test
TEST_DB_PASSWORD=<mat-khau-test-ngau-nhien>

# ── Ứng dụng ────────────────────────────────────────────────────────
APP_HOST_PORT=8080
ADMINER_HOST_PORT=8081

# JWT_SECRET: Base64 của >= 32 byte ngẫu nhiên (>= 44 ký tự).
# Tạo bằng PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
# Tạo bằng OpenSSL:
#   openssl rand -base64 48
JWT_SECRET=<base64-cua-48-byte-ngau-nhien>

# Endpoint chat-completions tương thích OpenAI. Bắt buộc https, không có
# userinfo/query/fragment (ràng buộc trong AiProperties).
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=<api-key-that>
AI_MODEL=gpt-4o-mini
